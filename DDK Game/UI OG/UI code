import java.util.Arrays;
import java.util.Scanner;

public class UI {
	private Player player;
	private Scanner scanner;
	
	public UI(Player player) {
		this.player = player;  // Assuming Player has a constructor that needs name
		this.scanner = new Scanner(System.in); //Create a Scanner object to capture user input
	}
	public void greetings() {
		System.out.println("Welcome To MUD");
		System.out.println("Type north/east/west/south to move");
		System.out.println("get <item>, drop <item>, or exit to quit");
	}
	public void playerStats() {
		// Expand later if you add health, strength, etc.
		System.out.println("Current inventory: "+ player.getInventory());
	}
	public void run() {
		greetings();
		
		while(true) {
			String p = player.showStatus();
			System.out.println(">");
			System.out.println(p);
			String command = scanner.nextLine().trim().toLowerCase();
			
			if(command.equals("exit")) {
				exit();
				break;
			}else if(command.startsWith("get")) {
				
				String i = player.getItem(command.substring(4).trim());
				System.out.println(i);
			}else if(command.startsWith("drop")) {
				player.dropItem(command.substring(5).trim());
				String r = player.dropItem(command.substring(5).trim());
				System.out.println(r);
			}else if(Arrays.asList("north", "south" ,"east", "west").contains(command)) {
				player.move(command);
			}else {
				System.out.println("I don't understand that command");
			}
			
		}
	}
	public void exit() {
		System.out.print("Goodbye, thanks for playing");  
	}
}


